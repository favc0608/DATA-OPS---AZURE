{
	"name": "ds_adls_comision_csv",
	"properties": {
		"description": "CSV de comisiones en raw/comisiones/. Separador ';', UTF-8, con encabezado. El nombre del archivo depende del periodo.",
		"linkedServiceName": {
			"referenceName": "ls_adls_lake",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"fileName": {
				"type": "string",
				"defaultValue": "ComisionEmpleados_V1_202610.csv"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().fileName",
					"type": "Expression"
				},
				"folderPath": "comisiones",
				"fileSystem": "raw"
			},
			"columnDelimiter": ";",
			"encodingName": "UTF-8",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "empleado_id",
				"type": "String"
			},
			{
				"name": "Nombre y Apellido",
				"type": "String"
			},
			{
				"name": "Comisión",
				"type": "String"
			}
		]
	}
}
